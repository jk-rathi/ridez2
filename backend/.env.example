# Copy to backend/.env; real values stay local and are ignored by Git.
APP_ENV=development
# Generate distinct random secrets; never commit real values.
JWT_SECRET=
USER_CODE_SECRET=
# google uses real road distance/duration; simulator is explicitly labeled sample data.
ROUTE_PROVIDER=google
GOOGLE_MAPS_SERVER_KEY=
# Development only. Set to 0 to block new simulated quotes and bookings.
SIMULATOR_ENABLED=1
# 500-metre increments; default searches ten 30-second rounds up to 5 km.
MATCH_MAX_RADIUS_M=5000
# Omit to use the explicitly labeled local SQLite development database.
# DATABASE_URL=mssql+pyodbc://...?...driver=ODBC+Driver+18+for+SQL+Server

# Optional, comma-separated exact browser origins when a reverse proxy changes Host.
# HTTPS is required in production; refresh cookies are Secure outside development.
# AUTH_TRUSTED_ORIGINS=https://ridez.example

# Render: use its environment settings and render.yaml, not this local file.
# Trust exactly one TLS proxy only when it is the sole path to the application.
# TRUST_PROXY_HEADERS=1

# Mock QR screens only; never transfers money. Defaults off outside development.
# TEST_PAYMENTS_ENABLED=1
